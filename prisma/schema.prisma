generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  SUPER_ADMIN
  ADMIN
  DRIVER
  GUARDIAN
  STUDENT
}

enum TripStatus {
  SCHEDULED
  IN_PROGRESS
  FINISHED
  CANCELED
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

enum IncidentType {
  STUCK
  ACCIDENT
  BREAKDOWN
  DELAY
  OTHER
}

enum LocationType {
  CITY
  DISTRICT
  VILLAGE // sítio / comunidade
  NEIGHBORHOOD
  OTHER
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String?
  cpf       String?  @unique
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  student           Student?
  drivenTrips       Trip[]         @relation("TripDriver")
  reportedIncidents Incident[]     @relation("IncidentReporter")
  guardianships     Guardianship[] @relation("GuardianOf")
  organizationMemberships OrganizationMember[]
}

model Student {
  userId       Int    @id
  registration String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  enrollments Enrollment[]
  guardians   Guardianship[] @relation("StudentOf")
}

model Guardianship {
  guardianId  Int
  studentId   Int
  followsTrip Boolean @default(true)

  guardian User    @relation("GuardianOf", fields: [guardianId], references: [id], onDelete: Cascade)
  student  Student @relation("StudentOf", fields: [studentId], references: [userId], onDelete: Cascade)

  @@id([guardianId, studentId])
}


model Bus {
  id       Int    @id @default(autoincrement())
  plate    String @unique
  capacity Int

  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  trips Trip[]
  

  @@index([organizationId])
}


model Location {
  id           Int          @id @default(autoincrement())
  name         String
  type         LocationType
  city         String
  district     String?
  latitude     Float?
  longitude    Float?
  neighborhood String?
  street       String?
  number       String?
  zipCode      String?

  tripsStartingHere Trip[]     @relation("TripOrigin")
  tripsEndingHere   Trip[]     @relation("TripDestination")
  stops             TripStop[]
}


model Trip {
  id       Int        @id @default(autoincrement())
  startsAt DateTime
  endsAt   DateTime?
  status   TripStatus @default(SCHEDULED)

  busId         Int
  driverId      Int
  originId      Int
  destinationId Int

  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  bus         Bus      @relation(fields: [busId], references: [id])
  driver      User     @relation("TripDriver", fields: [driverId], references: [id])
  origin      Location @relation("TripOrigin", fields: [originId], references: [id])
  destination Location @relation("TripDestination", fields: [destinationId], references: [id])

  stops       TripStop[]
  enrollments Enrollment[]
  incidents   Incident[]

  @@index([driverId])
  @@index([busId])
  @@index([organizationId])
}


model TripStop {
  tripId        Int
  locationId    Int
  stopOrder     Int
  scheduledTime DateTime?

  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id])

  @@id([tripId, locationId])
  @@unique([tripId, stopOrder])
}

model Enrollment {
  studentId  Int
  tripId     Int
  enrolledAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@id([studentId, tripId])
}

model Incident {
  id          Int            @id @default(autoincrement())
  type        IncidentType
  description String
  status      IncidentStatus @default(OPEN)
  createdAt   DateTime       @default(now())

  tripId     Int
  reporterId Int // "registra": o motorista

  trip     Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  reporter User @relation("IncidentReporter", fields: [reporterId], references: [id])
}


enum OrganizationType {
  COMPANY
  CITY_HALL
}


model Organization {
  id        Int              @id @default(autoincrement())
  name      String
  type      OrganizationType
  status OrganizationStatus @default(PENDING)
  createdAt DateTime         @default(now())

  members OrganizationMember[]
  buses    Bus[]
  trips    Trip[]
}


enum OrganizationRole {
  ADMIN
  DRIVER
}

enum OrganizationStatus {
  PENDING
  APPROVED
  REJECTED
}

model OrganizationMember {
  userId         Int
  organizationId Int
  role           OrganizationRole
  joinedAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
}


model AccessRole {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       AccessRole @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

